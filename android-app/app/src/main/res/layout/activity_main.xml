<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/text_label"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_disconnected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_disconnected"
                android:textColor="@color/text_label"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonConnect"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_navy"
            android:text="@string/button_connect"
            android:textAllCaps="false"
            android:textColor="@color/primary_navy_text"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/section_datetime"
            android:textAllCaps="true"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonSyncTime"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline_blue"
            android:text="@string/button_sync_time"
            android:textAllCaps="false"
            android:textColor="@color/outline_blue" />

        <TextView
            android:id="@+id/textSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sync_never"
            android:textColor="@color/text_error"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/section_marquee"
            android:textAllCaps="true"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editMarqueeText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_marquee_text"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/muted_text" />

        <TextView
            android:id="@+id/textMarqueeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/error_marquee_empty"
            android:textColor="@color/text_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/editMarqueeDuration"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_marquee_duration"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:text="30"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/muted_text" />

        <EditText
            android:id="@+id/editMarqueeSpeed"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_marquee_speed"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:text="300"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/muted_text" />

        <Button
            android:id="@+id/buttonSendMarquee"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_muted"
            android:text="@string/button_send_marquee"
            android:textAllCaps="false"
            android:textColor="@color/muted_text"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/marquee_help"
            android:textColor="@color/text_label"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/section_config"
            android:textAllCaps="true"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupTempUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioCelsius"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle_segment"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="@string/unit_celsius"
                android:textAllCaps="false"
                android:textColor="@color/text_toggle_segment" />

            <RadioButton
                android:id="@+id/radioFahrenheit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle_segment"
                android:button="@null"
                android:gravity="center"
                android:text="@string/unit_fahrenheit"
                android:textAllCaps="false"
                android:textColor="@color/text_toggle_segment" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSaveConfig"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_navy"
                android:text="@string/button_save_config"
                android:textAllCaps="false"
                android:textColor="@color/primary_navy_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonReadConfig"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline_gray"
                android:text="@string/button_read_config"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/textConfigSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_summary_unknown"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textConfigJsonLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/link_show_json"
                android:textColor="@color/outline_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/section_status"
            android:textAllCaps="true"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/text_dark"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/section_log"
            android:textAllCaps="true"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
